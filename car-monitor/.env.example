# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Кто может пользоваться ботом (chat id через запятую).
# Можно оставить пустым: тогда владельцем станет первый, кто напишет боту.
ALLOWED_CHAT_IDS=

# Как часто проверять каждый поиск, в секундах (не меньше 20).
# Слишком частые проверки — быстрый путь к капче на Avito. 60–120 — разумно.
CHECK_INTERVAL=60

# Регион для поиска текстом на Avito: rossiya, moskva, sankt-peterburg, ekaterinburg ...
# (как в адресе avito.ru/<регион>/avtomobili)
AVITO_REGION=rossiya

# 0 — показывать окно браузера (можно руками решить капчу), 1 — скрытый режим.
# В Docker оставьте 0: окно рисуется на виртуальном экране, сайты реже ставят капчу.
BROWSER_HEADLESS=0

# Использовать установленный Google Chrome вместо встроенного Chromium: chrome
# (сайты реже показывают капчу настоящему Chrome). Пусто — встроенный Chromium.
BROWSER_CHANNEL=

# Прокси для сайтов, если нужен: http://user:pass@host:port
PROXY=
