# Токен бота от @BotFather
BOT_TOKEN=
# id группы администраторов: добавьте бота в группу и напишите там /id
ADMIN_CHAT_ID=
# Ключ Claude API (необязательно). Без него бот отвечает на свободный текст по ключевым словам
ANTHROPIC_API_KEY=
# Ссылка на политику обработки персональных данных на сайте
PRIVACY_URL=

# ---- MAX ----
# Токен бота: «MAX для бизнеса» → Чат-боты → Настройки (или бот «MAX для бизнеса» → «Получить токен»)
MAX_TOKEN=
# Сертификат Минцифры для platform-api2.max.ru, если его нет в системе:
# curl -o russian_trusted_root_ca.crt https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
MAX_CA_FILE=
